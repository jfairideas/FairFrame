{
  "expo": {
    "name": "FairFrame",
    "slug": "fairframe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fairframe",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fairframe.app",
      "infoPlist": {
        "NSCameraUsageDescription": "FairFrame needs camera access so Chief can analyze your shots before you record.",
        "NSPhotoLibraryUsageDescription": "FairFrame needs photo library access so you can upload frames for Chief to review."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0B"
      },
      "package": "com.fairframe.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FairFrame to access your camera for visual storytelling analysis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FairFrame to access your photos to analyze uploaded frames."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
